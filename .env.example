# =============================================================================
# ELO connection
# =============================================================================

# ELO IX REST API base URL (without trailing slash).
# Example: https://elo.example.com/ix-INSTANCE
ELO_BASE_URL=

# Link-service base URL used to build human-clickable document/folder links.
# Set this to whatever URL prefix routes browsers to a document view when
# `/<objId>` is appended. Verify empirically: open a document in the web
# client, copy the URL prefix.
ELO_WEBCLIENT_URL=

# Technical user credentials (read-only role recommended).
# Wrap values in single quotes if they contain `#`, `$`, spaces, or other
# characters that dotenv would otherwise interpret.
ELO_USERNAME=
ELO_PASSWORD=

# Optional: separate HTTP Basic Auth credentials for a reverse proxy in front
# of IX (some deployments require Basic Auth on every path except /login).
# Defaults to ELO_USERNAME / ELO_PASSWORD if unset.
# ELO_BASIC_AUTH_USER=
# ELO_BASIC_AUTH_PASS=

# ELO ClientInfo defaults (sent on every login).
ELO_LANGUAGE=en
ELO_COUNTRY=US
ELO_TIMEZONE=UTC

# =============================================================================
# Project identification
# =============================================================================

# Index fields that identify a project on your masks. The defaults match the
# ELO Solutions standard project mask.
ELO_PROJECT_NUMBER_FIELD=PRJ_NO
ELO_PROJECT_NAME_FIELD=PRJ_NAME

# How a project *data room* is recognised. `elo_find_project_folder` uses this
# to tell a real project root from a sub-folder whose title merely matches the
# query — without it, both are returned with equal authority and an assistant
# can end up linking into the wrong project.
ELO_PROJECT_MARKER_FIELD=SOL_TYPE
ELO_PROJECT_MARKER_VALUE=PROJEKT

# =============================================================================
# Document content (elo_get_document_content)
# =============================================================================

# Set to false to unregister the content tool entirely (e.g. if document text
# must not leave ELO). Accepts only "true" or "false".
ELO_DOCUMENT_CONTENT_ENABLED=true

# Hard cap on the download size, enforced during transfer.
ELO_MAX_DOCUMENT_BYTES=15728640

# Characters of extracted text returned per call (~12-15k tokens). Longer
# documents are paged via the tool's `offset` argument.
ELO_MAX_TEXT_CHARS=50000

# Download timeout. Reverse proxies commonly cut a request at 60 s — raising
# this without also raising the proxy timeout only produces an opaque 504.
ELO_DOWNLOAD_TIMEOUT_MS=60000

# Concurrent downloads. Each holds the whole file in memory while parsing, so
# keep this low on small containers.
ELO_CONTENT_CONCURRENCY=2

# =============================================================================
# MCP transport
# =============================================================================

# Transport mode:
#   stdio: local subprocess (Claude Desktop). Default.
#   http : Streamable HTTP transport for remote hosting (Easypanel, etc.).
#          When set to http, MCP_SHARED_SECRET MUST be defined.
MCP_TRANSPORT=stdio

# HTTP transport bind address and port.
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=3000

# Shared secret for Bearer-token auth on the HTTP transport.
# Required when MCP_TRANSPORT=http. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# MCP_SHARED_SECRET=

# =============================================================================
# Logging
# =============================================================================

# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
