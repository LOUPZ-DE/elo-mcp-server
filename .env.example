# =============================================================================
# ELO connection
# =============================================================================

# ELO IX REST API base URL (without trailing slash).
# Example: https://elo.example.com/ix-INSTANCE
ELO_BASE_URL=

# Link-service base URL used to build human-clickable document/folder links.
# Set this to whatever URL prefix routes browsers to a document view when
# `/<objId>` is appended. Verify empirically: open a document in the web
# client, copy the URL prefix.
ELO_WEBCLIENT_URL=

# Technical user credentials (read-only role recommended).
# Wrap values in single quotes if they contain `#`, `$`, spaces, or other
# characters that dotenv would otherwise interpret.
ELO_USERNAME=
ELO_PASSWORD=

# Optional: separate HTTP Basic Auth credentials for a reverse proxy in front
# of IX (some deployments require Basic Auth on every path except /login).
# Defaults to ELO_USERNAME / ELO_PASSWORD if unset.
# ELO_BASIC_AUTH_USER=
# ELO_BASIC_AUTH_PASS=

# ELO ClientInfo defaults (sent on every login).
ELO_LANGUAGE=en
ELO_COUNTRY=US
ELO_TIMEZONE=UTC

# =============================================================================
# Project identification
# =============================================================================

# Index fields that identify a project on your masks. The defaults match the
# ELO Solutions standard project mask.
ELO_PROJECT_NUMBER_FIELD=PRJ_NO
ELO_PROJECT_NAME_FIELD=PRJ_NAME

# How a project *data room* is recognised. `elo_find_project_folder` uses this
# to tell a real project root from a sub-folder whose title merely matches the
# query — without it, both are returned with equal authority and an assistant
# can end up linking into the wrong project.
ELO_PROJECT_MARKER_FIELD=SOL_TYPE
ELO_PROJECT_MARKER_VALUE=PROJEKT

# =============================================================================
# Document content (elo_get_document_content)
# =============================================================================

# Set to false to unregister the content tool entirely (e.g. if document text
# must not leave ELO). Accepts only "true" or "false".
ELO_DOCUMENT_CONTENT_ENABLED=true

# Hard cap on the download size, enforced during transfer.
ELO_MAX_DOCUMENT_BYTES=15728640

# Characters of extracted text returned per call (~12-15k tokens). Longer
# documents are paged via the tool's `offset` argument.
ELO_MAX_TEXT_CHARS=50000

# Download timeout. Reverse proxies commonly cut a request at 60 s — raising
# this without also raising the proxy timeout only produces an opaque 504.
ELO_DOWNLOAD_TIMEOUT_MS=60000

# Concurrent downloads. Each holds the whole file in memory while parsing, so
# keep this low on small containers.
ELO_CONTENT_CONCURRENCY=2

# =============================================================================
# MCP transport
# =============================================================================

# Transport mode:
#   stdio: local subprocess (Claude Desktop). Default.
#   http : Streamable HTTP transport for remote hosting (Easypanel, etc.).
#          When set to http, MCP_SHARED_SECRET MUST be defined.
MCP_TRANSPORT=stdio

# HTTP transport bind address and port.
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=3000

# Shared secret for Bearer-token auth on the HTTP transport.
# Required when MCP_AUTH_MODE is "shared" (the default) or "both".
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# MCP_SHARED_SECRET=

# =============================================================================
# OAuth 2.1 + Dynamic Client Registration (optional)
# =============================================================================
#
# Lets a user connect with their OWN ELO account instead of pasting a token:
# the client registers itself (RFC 7591), the user gets a login form, their
# credentials are checked against ELO, and every tool call then runs under that
# user's ELO permissions. See docs/oauth-dcr.md.
#
# Leave MCP_AUTH_MODE unset and nothing below matters — the server behaves
# exactly as it did before, and none of the OAuth endpoints are mounted.

# What /mcp accepts as a bearer token:
#   shared — only MCP_SHARED_SECRET. The default; unchanged behaviour.
#   oauth  — only tokens from the built-in authorization server.
#   both   — either, on the same endpoint. Use this to add OAuth without
#            disturbing existing API-key consumers (n8n, Make, Open WebUI).
# MCP_AUTH_MODE=shared

# Public origin of this server, no trailing slash. Must match EXACTLY what
# clients dial — it is the OAuth issuer and the token audience.
#   Easypanel example: https://core-elo-mcp-server.xapfa3.easypanel.host
# PUBLIC_BASE_URL=

# Signing keys, minimum 32 characters, different from each other. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# OAUTH_TOKEN_SECRET=
# OAUTH_SESSION_SECRET=

# Access-token lifetime in seconds. Short is fine: clients refresh silently.
# OAUTH_ACCESS_TOKEN_TTL=3600

# Refresh-token lifetime in seconds (default 30 days).
# OAUTH_REFRESH_TOKEN_TTL=2592000

# Name shown on the login page and in the discovery documents.
# OAUTH_SERVER_NAME=ELO MCP Server

# Cap on registered clients. Registration is unauthenticated by design, so the
# oldest registration is evicted once this is reached.
# OAUTH_MAX_CLIENTS=500

# How long a signed-in user's ELO session survives without being used, in
# seconds (default 8 hours). After that they log in again. Credentials are held
# in memory only and are lost on restart — by design; see docs/oauth-dcr.md.
# ELO_USER_SESSION_TTL=28800

# Maximum concurrent signed-in users. Each can hold one ELO IX session, so this
# also bounds the licence load. Least-recently-used sessions are evicted first.
# ELO_MAX_USER_SESSIONS=50

# NOTE: with OAuth enabled, ELO_BASIC_AUTH_USER / ELO_BASIC_AUTH_PASS stop being
# cosmetic. End users authenticate to IX itself, but the reverse proxy in front
# of it must keep seeing the technical account — so set these explicitly if your
# proxy credentials differ from ELO_USERNAME / ELO_PASSWORD.

# =============================================================================
# Logging
# =============================================================================

# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
